<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground — white rounded checkmark + cyan accent dot.
     Safe zone adaptive icon = 66dp tengah (dari 108dp), jadi elemen dibuat
     agak ke dalam agar tidak terpotong mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White rounded checkmark -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,54 L49,65 L74,40" />

    <!-- Cyan accent dot, lower-right -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M73,73 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
