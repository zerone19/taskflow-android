<?xml version="1.0" encoding="utf-8"?>
<!--
  TaskFlow logo — vector drawable.
  Flat design: indigo squircle background + white rounded checkmark + cyan accent dot.
  Dibuat dari design/taskflow_app_icon/screen.png (sesuai instruksi Master).
  Vector → tajam di semua resolusi (mipmap-anydpi / launcher adaptive).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background indigo (squircle dicapai via adaptive icon mask oleh sistem) -->
    <path
        android:fillColor="#4F46E5"
        android:pathData="M0,0h108v108h-108z" />

    <!-- White rounded checkmark (stroke caps & join rounded) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M33,55 L47,69 L77,38" />

    <!-- Cyan accent dot, lower-right -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M76,80 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
</vector>
